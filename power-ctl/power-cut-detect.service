[Unit]
Description=Power-cut detector (BCM 18)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=<service-user>
WorkingDirectory=<repo>/power-ctl
ExecStart=/usr/bin/python3 <repo>/power-ctl/power_cut_detect.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
